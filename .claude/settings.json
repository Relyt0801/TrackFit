{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(grep *)",
      "Bash(curl *)",
      "mcp__233f22b9-8aaf-4828-bad0-2e49184a8aab__*",
      "mcp__19f0dad7-f2d3-4f51-a4dc-ce93f6789a70__*",
      "mcp__github__*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-file-reminder.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[TrackFit UX UI Pro Max] Session complete. Run /ux-review to audit all UI changes, /design to sync with Canva, or /feedback to get full UX feedback report.'"
          }
        ]
      }
    ]
  }
}
